rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shipments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'items', 'branch', 'type', 'supplierCode', 'loadedBy', 'loadedAt'])
        // «تم تحميلها»: both keys arrive together, and a re-load overwrites them
        && (!('loadedBy' in request.resource.data)
            || (request.resource.data.loadedBy is string && request.resource.data.loadedBy.size() <= 50))
        && (!('loadedAt' in request.resource.data)
            || (request.resource.data.loadedAt is number))
        && (!('supplierCode' in request.resource.data)
            || (request.resource.data.supplierCode is string && request.resource.data.supplierCode.size() <= 20))
        && (!('branch' in request.resource.data)
            || (request.resource.data.branch is string && request.resource.data.branch.size() <= 40))
        && (!('type' in request.resource.data)
            || (request.resource.data.type is string && request.resource.data.type.size() <= 30))
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdBy is string && request.resource.data.createdBy.size() <= 50
        && request.resource.data.createdAt is number
        && request.resource.data.items is list && request.resource.data.items.size() <= 200;
      // edit changes only name + items; createdBy/createdAt stay as first written
      allow update: if request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'items', 'branch', 'type', 'supplierCode', 'loadedBy', 'loadedAt'])
        // «تم تحميلها»: both keys arrive together, and a re-load overwrites them
        && (!('loadedBy' in request.resource.data)
            || (request.resource.data.loadedBy is string && request.resource.data.loadedBy.size() <= 50))
        && (!('loadedAt' in request.resource.data)
            || (request.resource.data.loadedAt is number))
        && (!('supplierCode' in request.resource.data)
            || (request.resource.data.supplierCode is string && request.resource.data.supplierCode.size() <= 20))
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('branch', '') == resource.data.get('branch', '')
        && (!('type' in request.resource.data)
            || (request.resource.data.type is string && request.resource.data.type.size() <= 30))
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.items is list && request.resource.data.items.size() <= 200;
      allow delete: if true;
    }
    // stocktake sessions: a shipment with the system quantity kept next to the counted one
    match /counts/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'items', 'branch'])
        && (!('branch' in request.resource.data)
            || (request.resource.data.branch is string && request.resource.data.branch.size() <= 40))
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdBy is string && request.resource.data.createdBy.size() <= 50
        && request.resource.data.createdAt is number
        && request.resource.data.items is list && request.resource.data.items.size() <= 500;
      // same as shipments: only name + items may change, the branch a count was taken in never moves
      allow update: if request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'items', 'branch'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('branch', '') == resource.data.get('branch', '')
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.items is list && request.resource.data.items.size() <= 500;
      allow delete: if true;
    }
    // الصلاحيات: one row per product and expiry date. The month is derived from day/month/year,
    // so an empty month simply has no rows — nothing to create and nothing to clean up.
    match /expiry/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['barcode', 'name', 'qty', 'day', 'month', 'year', 'branch', 'createdBy', 'createdAt'])
        && request.resource.data.barcode is string && request.resource.data.barcode.size() <= 32
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.day is number && request.resource.data.day >= 1 && request.resource.data.day <= 31
        && request.resource.data.month is number && request.resource.data.month >= 1 && request.resource.data.month <= 12
        && request.resource.data.year is number && request.resource.data.year >= 2000 && request.resource.data.year <= 2100
        && (!('branch' in request.resource.data)
            || (request.resource.data.branch is string && request.resource.data.branch.size() <= 40))
        && request.resource.data.createdBy is string && request.resource.data.createdBy.size() <= 50
        && request.resource.data.createdAt is number;
      // a row moves month by changing its date; the product, the branch and who wrote it never move
      allow update: if request.resource.data.keys().hasOnly(['barcode', 'name', 'qty', 'day', 'month', 'year', 'branch', 'createdBy', 'createdAt'])
        && request.resource.data.barcode == resource.data.barcode
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('branch', '') == resource.data.get('branch', '')
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.day is number && request.resource.data.day >= 1 && request.resource.data.day <= 31
        && request.resource.data.month is number && request.resource.data.month >= 1 && request.resource.data.month <= 12
        && request.resource.data.year is number && request.resource.data.year >= 2000 && request.resource.data.year <= 2100;
      allow delete: if true;
    }
    // admin settings: one doc, fixed key set, short PINs, small lists
    match /config/{doc} {
      allow read: if true;
      allow write: if doc == 'app'
        && request.resource.data.keys().hasOnly(['managerPin', 'adminPin', 'branches', 'shipmentTypes', 'users', 'suppliers', 'label'])
        // label = the shelf-label size, the paper and the shop logo as a data URL. The logo is
        // capped because every page reads this doc at boot.
        && (!('label' in request.resource.data)
            || (request.resource.data.label is map
                && request.resource.data.label.size() <= 6
                && request.resource.data.label.get('logo', '') is string
                && request.resource.data.label.get('logo', '').size() <= 200000))
        && (!('users' in request.resource.data)
            || (request.resource.data.users is list && request.resource.data.users.size() <= 40))
        // suppliers is the shop's list of vendor names, offered as the shipment name
        && (!('suppliers' in request.resource.data)
            || (request.resource.data.suppliers is list && request.resource.data.suppliers.size() <= 1000))
        && request.resource.data.managerPin is string && request.resource.data.managerPin.size() <= 8
        && request.resource.data.adminPin is string && request.resource.data.adminPin.size() <= 8
        && request.resource.data.branches is list && request.resource.data.branches.size() <= 10
        && request.resource.data.shipmentTypes is list && request.resource.data.shipmentTypes.size() <= 10;
    }
    match /logs/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['who', 'action', 'target', 'at'])
        && request.resource.data.who is string && request.resource.data.who.size() <= 60
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && request.resource.data.target is string && request.resource.data.target.size() <= 120
        && request.resource.data.at is number;
      allow update, delete: if false;   // an audit row you can edit is not an audit row
    }
    match /products/{barcode} {
      allow read: if true;
      allow delete: if true;
      // stock = { branch: quantity } from that branch's stocktake sheet; qty is the older
      // shop-wide import, still read as the fallback. unit is the third column of the catalog
      // sheet (كرتونة / كيلو / علبة) — shown next to the name, never counted.
      allow create, update: if barcode.size() <= 32
        && request.resource.data.keys().hasOnly(['name', 'qty', 'stock', 'unit', 'price', 'factor'])
        && (!('price' in request.resource.data)
            || (request.resource.data.price is number && request.resource.data.price >= 0))
        // معامل التحويل: how many of the small unit are in the big one, carried for display only
        && (!('factor' in request.resource.data)
            || (request.resource.data.factor is number && request.resource.data.factor >= 0))
        && (!('unit' in request.resource.data)
            || (request.resource.data.unit is string && request.resource.data.unit.size() <= 30))
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (!('qty' in request.resource.data)
            || (request.resource.data.qty is number && request.resource.data.qty >= 0))
        && (!('stock' in request.resource.data)
            || (request.resource.data.stock is map && request.resource.data.stock.size() <= 10));
    }
  }
}
